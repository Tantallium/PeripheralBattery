<Window x:Class="PeripheralBattery.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="外设电量" Icon="Assets/PeripheralBattery.ico" Width="440" Height="690" MinHeight="540"
 ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
 Background="#F4F6FA" Foreground="#233044" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="22,20,22,18">
   <DockPanel Margin="0,0,0,4">
    <TextBlock Text="外设电量" FontSize="25" FontWeight="SemiBold"/>
    <TextBlock Text="0.2.3 体验版" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#7A8495"/>
   </DockPanel>
   <TextBlock Text="鼠标、键盘和手柄，一处查看。" Foreground="#68758B" Margin="0,3,0,18"/>
   <ItemsControl x:Name="DeviceList">
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Background="White" CornerRadius="13" Padding="17,15" Margin="0,0,0,12">
       <StackPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Transport}" Foreground="#7A8495" FontSize="11" Margin="0,5,0,0"/>
         </StackPanel>
         <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="{Binding ReadingOpacity}"/>
        </Grid>
        <ProgressBar Value="{Binding BarValue, Mode=OneWay}" Maximum="100" Height="5" Margin="0,14,0,10" BorderThickness="0" Background="#EDF0F6" Foreground="{Binding Accent}" Opacity="{Binding ReadingOpacity}"/>
        <DockPanel>
         <TextBlock Text="{Binding Status}" Foreground="{Binding Accent}"/>
         <TextBlock Text="{Binding Updated}" Foreground="#7A8495" HorizontalAlignment="Right" FontSize="11"/>
        </DockPanel>
        <TextBlock Text="{Binding Hint}" Foreground="#7A8495" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <DockPanel Margin="0,2,0,12">
    <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新" Click="Refresh_Click" Margin="12,0,0,0"/>
    <CheckBox x:Name="AutoRefreshCheckBox" DockPanel.Dock="Left" Content="自动刷新（5 秒）" Click="AutoRefresh_Click" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <TextBlock x:Name="LastCheckText" Text="准备读取…" Foreground="#7A8495" FontSize="11" VerticalAlignment="Center"/>
   </DockPanel>
   <WrapPanel>
    <Button Content="设置" Click="Settings_Click"/>
    <Button Content="诊断信息" Click="Diagnostics_Click"/>
    <Button Content="退出" Click="Exit_Click" Margin="0"/>
   </WrapPanel>
   <TextBlock Text="关闭窗口后，会继续在任务栏通知区域运行。" Foreground="#7A8495" FontSize="11" TextWrapping="Wrap" Margin="0,13,0,0"/>
  </StackPanel>
 </ScrollViewer>
</Window>
